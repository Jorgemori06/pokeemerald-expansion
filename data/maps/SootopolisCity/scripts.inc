SootopolisCity_EventScript_WallaceMoveFromGym::
	applymovement LOCALID_SOOTOPOLIS_WALLACE, SootopolisCity_Movement_WallaceMoveFromGym
	waitmovement 0
	copyobjectxytoperm LOCALID_SOOTOPOLIS_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 1
	return

SootopolisCity_EventScript_WallaceMoveFromGymWest::
	applymovement LOCALID_SOOTOPOLIS_WALLACE, SootopolisCity_Movement_WallaceMoveFromGymWest
	waitmovement 0
	copyobjectxytoperm LOCALID_SOOTOPOLIS_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 2
	return

SootopolisCity_EventScript_GoToSkyPillar::
	msgbox SootopolisCity_Text_HaventYouScaledSkyPillar, MSGBOX_DEFAULT
	release
	end

SootopolisCity_EventScript_GoToGym::
	msgbox SootopolisCity_Text_DazzledByMentor, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Movement_WallaceMoveFromGym:
	walk_right
	walk_in_place_faster_down
	step_end

SootopolisCity_Movement_WallaceMoveFromGymWest:
	walk_left
	walk_in_place_faster_down
	step_end

SootopolisCity_EventScript_Maxie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_MaxieRayquaza
	msgbox SootopolisCity_Text_GroudonPleaseStop, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_MaxieRayquaza::
	msgbox SootopolisCity_Text_AfterAllOurScheming, MSGBOX_DEFAULT
	setflag FLAG_MET_MAXIE_SOOTOPOLIS
	goto_if_set FLAG_MET_ARCHIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_Archie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_ArchieRayquaza
	msgbox SootopolisCity_Text_KyogreCalmDown, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_ArchieRayquaza::
	msgbox SootopolisCity_Text_TryingMeaninglessToPokemon, MSGBOX_DEFAULT
	setflag FLAG_MET_ARCHIE_SOOTOPOLIS
	goto_if_set FLAG_MET_MAXIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_MaxieArchieLeave::
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE
	setflag FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_MAXIE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE
	setvar VAR_MT_PYRE_STATE, 2
	warpsilent MAP_SOOTOPOLIS_CITY, 31, 34
	waitstate
	releaseall
	end

@ Unused
SootopolisCity_Movement_Levitate::
	levitate
	step_end

@ Unused
SootopolisCity_Movement_DestroyTask::
	destroy_extra_task
	step_end

SootopolisCity_Text_GymSign:
	.string "GIMNASIO POKéMON DE ARRECÍPOLIS\n"
	.string "LÍDER: GALANO\p"
	.string "“¡El LÍDER con la belleza del agua\n"
	.string "pura!”$"

SootopolisCity_Text_CitySign:
	.string "CIUDAD ARRECÍPOLIS\p"
	.string "“La ciudad mística donde duerme\n"
	.string "la historia”.$"

SootopolisCity_Text_DoorIsClosed:
	.string "La puerta está cerrada.$"

SootopolisCity_Text_PhysicallyFitLivingHere:
	.string "Bucear en el mar. Subir y bajar\n"
	.string "escaleras todo el rato…\p"
	.string "Si vives aquí, acabas en plena\n"
	.string "forma.$"

SootopolisCity_Text_GiantPokemonSuddenlyAppeared:
	.string "¡De repente han aparecido estos\n"
	.string "POKéMON gigantes en mitad de la ciudad!\p"
	.string "¡Y nunca los había visto!\p"
	.string "¿Por qué se pelean así?\p"
	.string "¿Por qué no pueden ser amigos esos\n"
	.string "POKéMON?$"

SootopolisCity_Text_WhatIsThatGreenPokemon:
	.string "¿Qué? ¿Qué? ¿Qué?\n"
	.string "¡¿Qué es ese POKéMON verde?!$"

SootopolisCity_Text_WhereDidLegendariesGo:
	.string "GROUDON y KYOGRE…\n"
	.string "¿Adónde habrán ido?\p"
	.string "¿Causarán sequías o diluvios en\n"
	.string "otra parte?$"

SootopolisCity_Text_TwoPokemonArentAngry:
	.string "No sé por qué, pero me da la\n"
	.string "sensación de que no están enfadados.\p"
	.string "Creo que… seguramente no pueden\n"
	.string "controlar su propio poder…$"

SootopolisCity_Text_FlyingMonStoppedRampage:
	.string "Ese POKéMON volador bajó del cielo\n"
	.string "y frenó a los POKéMON desbocados…$"

SootopolisCity_Text_WonderWhatWorldIsLike:
	.string "Yo… Nunca he salido de esta ciudad.\p"
	.string "¿Cómo será el mundo al otro lado de\n"
	.string "este cielo redondo?$"

SootopolisCity_Text_ThisIsWicked:
	.string "¡Hala!\n"
	.string "¡Esto es brutal!$"

SootopolisCity_Text_ThatWasWicked:
	.string "¡Hala!\n"
	.string "¡Eso ha sido brutal!$"

SootopolisCity_Text_GoRedAndBlueMon:
	.string "¡A por todas, POKéMON rojo!\n"
	.string "¡No te rindas, POKéMON azul!$"

SootopolisCity_Text_DoYouKnowMonNames:
	.string "… … … … … …\p"
	.string "Hola, ¿sabes cómo se llaman esos\n"
	.string "POKéMON que se pelean ahí?$"

SootopolisCity_Text_GreenOneSettlesThings:
	.string "Me preguntaba cuál ganaría, el rojo\n"
	.string "o el azul, pero, ay, ¡es el verde\l"
	.string "el que lo arregla todo!\p"
	.string "¡Menudo giro de los acontecimientos!$"

SootopolisCity_Text_SeeingLegendWithOwnEyes:
	.string "Hay una leyenda antigua que dice que\n"
	.string "la tierra y el mar se formaron en un\l"
	.string "combate colosal entre POKéMON.\p"
	.string "¡Pues lo estoy viendo con mis\n"
	.string "propios ojos!\p"
	.string "¡Uau! ¡Nunca pensé que vería algo\n"
	.string "tan enorme!$"

SootopolisCity_Text_SawLegendWithOwnEyes:
	.string "Hay una leyenda antigua que dice que\n"
	.string "la tierra y el mar se formaron en un\l"
	.string "combate colosal entre POKéMON.\p"
	.string "¡Pues lo he visto con mis propios\n"
	.string "ojos!\p"
	.string "¡Uau! ¡Nunca pensé que vería algo\n"
	.string "tan enorme!$"

SootopolisCity_Text_BigPokemonFighting:
	.string "¡Un POKéMON enorme se está peleando\n"
	.string "con otro POKéMON enorme!\p"
	.string "¡Por favor, que alguien los pare!$"

SootopolisCity_Text_PrettyMonCameFromSky:
	.string "Un POKéMON precioso bajó del cielo…$"

SootopolisCity_Text_SootopolisWillBeWrecked:
	.string "¡Ay, no!\n"
	.string "¡CIUDAD ARRECÍPOLIS va a quedar\l"
	.string "destrozada!$"

SootopolisCity_Text_SootopolisDidntGetWrecked:
	.string "¡CIUDAD ARRECÍPOLIS no ha quedado\n"
	.string "destrozada!$"

SootopolisCity_Text_NoOrdinaryTourist:
	.string "¡Mm!\n"
	.string "¿Has venido hasta ARRECÍPOLIS?\l"
	.string "No vienes de simple turismo.\p"
	.string "Aunque supongo que eso tampoco te\n"
	.string "convierte en alguien extraordinario.$"

SootopolisCity_Text_CityRegainedCalm:
	.string "La ciudad ha recuperado la calma…$"

SootopolisCity_Text_CaveOfOriginPleaseLeave:
	.string "¿Quién eres?\p"
	.string "Esto es la CUEVA ANCESTRAL.\p"
	.string "Dicen que aquí reviven los espíritus\n"
	.string "de los POKéMON calmados en el MONTE\l"
	.string "PÍRICO.\p"
	.string "Por favor, vete.$"

SootopolisCity_Text_LeadSuperiorTrainerToCave:
	.string "Una persona de voluntad fuerte y\n"
	.string "talento superior…\p"
	.string "Alguien que conozca muchos tipos de\n"
	.string "POKéMON y tenga experiencia con ellos…\p"
	.string "Si apareciera alguien así, PLUBIO me\n"
	.string "pidió que le guiara hasta esta\l"
	.string "CUEVA.$"

SootopolisCity_Text_AwakenedPokemonClash:
	.string "Ay, madre…\p"
	.string "El choque entre los dos POKéMON\n"
	.string "despertados lo ha calmado el\l"
	.string "despertar de un tercer POKéMON…$"

SootopolisCity_Text_CaveOfOriginSleepsToo:
	.string "Esto es la CUEVA ANCESTRAL…\p"
	.string "Pasada la crisis, la cueva también\n"
	.string "dormirá…$"

SootopolisCity_Text_SootopolisSkyBeautiful:
	.string "ARRECÍPOLIS nació como pueblo en el\n"
	.string "cráter de un volcán.\p"
	.string "Si miras al cielo, también se ve el\n"
	.string "borde del cráter.\l"
	.string "Así que solo ves un círculo de cielo.\p"
	.string "Pero por eso el cielo de ARRECÍPOLIS\n"
	.string "es el más bonito.$"

SootopolisCity_Text_GiganticPokemonFight:
	.string "Cuando dos POKéMON tan gigantes se\n"
	.string "pelean con tanta furia, poco\l"
	.string "podemos hacer.$"

SootopolisCity_Text_FearedWorstWhenPokemonFlewDown:
	.string "Cuando bajó ese tercer POKéMON, me\n"
	.string "temí lo peor.$"

SootopolisCity_Text_NightSkyFavoriteScenery:
	.string "Un círculo de cielo nocturno enmarcado\n"
	.string "por el cráter de un volcán…\p"
	.string "Y en ese anillo, las estrellas titilan\n"
	.string "como si estuvieran vivas…\l"
	.string "Es mi paisaje favorito.$"

SootopolisCity_Text_WeatherWentWild:
	.string "Esta mañana hacía buen tiempo,\n"
	.string "pero…\p"
	.string "De repente se formaron nubes negras,\n"
	.string "empezó a llover a cántaros y hubo\l"
	.string "truenos y relámpagos.\p"
	.string "¡El tiempo se ha vuelto loco del\n"
	.string "todo!\p"
	.string "¿Es todo por culpa de esos\n"
	.string "POKéMON?$"

SootopolisCity_Text_YouBroughtFlyingMon:
	.string "¿Oh?\p"
	.string "¿Has sido tú quien ha traído aquí\n"
	.string "ese POKéMON volador?\p"
	.string "¡Pues qué pasada!$"

SootopolisCity_Text_GroudonPleaseStop:
	.string "MAGNO: G… GROUDON…\n"
	.string "¡Por favor! ¡Para!\p"
	.string "¡Ya sé de lo que eres capaz!\p"
	.string "¡Si sigues, no solo ARRECÍPOLIS, todo\n"
	.string "HOENN quedará arrasado!$"

SootopolisCity_Text_AfterAllOurScheming:
	.string "MAGNO: Así que los POKéMON\n"
	.string "superancestrales no eran solo\l"
	.string "GROUDON y KYOGRE…\p"
	.string "Después de todos nuestros planes\n"
	.string "inútiles y esfuerzos frenéticos, un\l"
	.string "simple gesto de ese POKéMON lo arregla\l"
	.string "todo como si nada hubiera pasado…\p"
	.string "Ja…\n"
	.string "Jajajaja…$"

SootopolisCity_Text_KyogreCalmDown:
	.string "AQUILES: ¡KYOGRE! ¡¿Qué te pasa?!\n"
	.string "¡Mira aquí! ¡Es el PRISMA ROJO!\l"
	.string "¡Cálmate! ¡KYOGRE!\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "¡No hay manera!\n"
	.string "¡No responde en absoluto!$"

SootopolisCity_Text_TryingMeaninglessToPokemon:
	.string "AQUILES: KYOGRE y GROUDON se han ido\n"
	.string "volando a saber dónde.\p"
	.string "El tiempo en HOENN ha vuelto\n"
	.string "a la normalidad…\p"
	.string "Jaja…\n"
	.string "Jajaja…\p"
	.string "Quizá lo que intentábamos hacer era\n"
	.string "algo pequeño, incluso sin sentido,\l"
	.string "para los POKéMON…$"

SootopolisCity_Text_InvolvedWithCrisisComeWithMe:
	.string "MÁXIMO: Esos POKéMON que se pelean…\n"
	.string "GROUDON… Y KYOGRE…\p"
	.string "Los dos POKéMON superancestrales\n"
	.string "han despertado de un largo sueño…\p"
	.string "Y ahora chocan entre sí con una\n"
	.string "energía que no pueden controlar…\p"
	.string "… {PLAYER}{KUN}.\p"
	.string "Si estás aquí ahora, entiendo que\n"
	.string "quieres implicarte en esta crisis.\p"
	.string "Pues bien, hay alguien a quien me\n"
	.string "gustaría que conocieras.\p"
	.string "Ven conmigo, por favor.$"

SootopolisCity_Text_DoesThisMakeYourFearPokemon:
	.string "MÁXIMO: Escucha, {PLAYER}{KUN}.\p"
	.string "¿Ver a GROUDON y KYOGRE te hace pensar\n"
	.string "que hay que temer a los POKéMON?\p"
	.string "Pero no es verdad.\n"
	.string "Los POKéMON son mucho más…\p"
	.string "… ¿Por qué te pregunto esto?\n"
	.string "Si ya lo sabes.$"

SootopolisCity_Text_HereWereAreHelpWallace:
	.string "MÁXIMO: ¡Bueno, ya estamos!\p"
	.string "Ahí dentro está alguien llamado\n"
	.string "PLUBIO.\p"
	.string "Creo que tienes lo que hace falta\n"
	.string "para ayudarle…$"

SootopolisCity_Text_KnowWhatsNeededToHelpHim:
	.string "MÁXIMO: Creo que tienes lo que hace\n"
	.string "falta para ayudarle…$"

SootopolisCity_Text_NeverBeenToSkyPillar:
	.string "MÁXIMO: El PILAR CELESTE…\p"
	.string "Nunca he estado allí.\n"
	.string "¿Dónde estará?$"

SootopolisCity_Text_SoThatsRayquaza:
	.string "MÁXIMO: Así que ese es RAYQUAZA…\p"
	.string "Es increíble cómo los dos POKéMON\n"
	.string "desbocados han huido de él con miedo…$"

SootopolisCity_Text_MaxieArchieLeft:
	.string "MÁXIMO: Parece que tanto MAGNO como\n"
	.string "AQUILES se han ido a alguna parte.\p"
	.string "Quizá hayan ido al MONTE PÍRICO a\n"
	.string "devolver los PRISMAS…$"

SootopolisCity_Text_HaventYouScaledSkyPillar:
	.string "PLUBIO: ¿Oh?\n"
	.string "¿{PLAYER}{KUN}?\p"
	.string "¿Aún no has subido al PILAR\n"
	.string "CELESTE?\p"
	.string "Estoy seguro de que puedes llegar a\n"
	.string "la cima del PILAR CELESTE…$"

SootopolisCity_Text_AquaMagmaDidntMeanHarm:
	.string "PLUBIO: {PLAYER}{KUN}…\p"
	.string "No creo que los líderes del EQUIPO\n"
	.string "MAGMA y AQUA quisieran hacer daño.\p"
	.string "No estaría de más escuchar lo que\n"
	.string "tienen que decir.$"

SootopolisCity_Text_ThankYouForHelpAcceptThis:
	.string "PLUBIO: {PLAYER}{KUN}…\n"
	.string "No me equivocaba contigo.\p"
	.string "Gracias a tu ayuda, ARRECÍPOLIS…\n"
	.string "No, todo HOENN se ha salvado.\p"
	.string "En nombre de todos, te doy las gracias.\p"
	.string "Esto es un regalo mío.\n"
	.string "Acéptalo, por favor.$"

SootopolisCity_Text_ExplainWaterfallGoToGym:
	.string "Esa MÁQUINA OCULTA contiene CASCADA.\p"
	.string "Si tienes la MEDALLA LLUVIA, un POKéMON\n"
	.string "que sepa ese movimiento de MO puede\l"
	.string "subir por las cascadas.\p"
	.string "¿Y dónde está la MEDALLA LLUVIA?\n"
	.string "Ya lo sabes, ¿verdad?\p"
	.string "¡Eso es! Tienes que ganar al LÍDER\n"
	.string "del GIMNASIO de ARRECÍPOLIS.\p"
	.string "Cuando estés preparado, cruza esa\n"
	.string "puerta.$"

SootopolisCity_Text_DazzledByMentor:
	.string "PLUBIO: Seguro que te deslumbrará el\n"
	.string "estilo de combate tan elegante de\l"
	.string "mi maestro.$"
