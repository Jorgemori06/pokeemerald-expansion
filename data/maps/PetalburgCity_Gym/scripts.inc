	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "PAPÁ: ¿Mm?\p"
	.string "¡Anda, si es {PLAYER}!\n"
	.string "¿Ya has terminado con la mudanza?\p"
	.string "Me sorprende que hayas llegado\n"
	.string "hasta aquí tú solo.\p"
	.string "Ah, ya veo.\n"
	.string "Vienes con tu POKéMON.\p"
	.string "Mm… Entonces vas a ser ENTRENADOR\n"
	.string "como yo, {PLAYER}.\p"
	.string "¡Qué buena noticia!\n"
	.string "¡Tengo muchas ganas de verlo!$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "Eh… Yo…\n"
	.string "Quería un POKéMON, por favor…$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "PAPÁ: ¿Mm? Tú eres… Eh… Ah, claro.\n"
	.string "Eres BLASCO, ¿verdad?$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "BLASCO: Me voy a vivir con mis\n"
	.string "parientes a PUEBLO VERDEGAL.\p"
	.string "Pensé que me sentiría solo, así que\n"
	.string "quería llevarme un POKéMON.\p"
	.string "Pero nunca he atrapado un POKéMON.\n"
	.string "No sé cómo se hace…$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "PAPÁ: Mm. Ya veo.$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "PAPÁ: {PLAYER}, lo has oído,\n"
	.string "¿verdad?\p"
	.string "Ve con BLASCO y asegúrate de que\n"
	.string "atrapa un POKéMON sin problemas.$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "BLASCO, toma, te presto mi POKéMON.\p"
	.string "¡BLASCO ha recibido un ZIGZAGOON!$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "BLASCO: ¡Hala!\n"
	.string "¡Un POKéMON!\p"
	.string "PAPÁ: Mm. También te doy una POKé BALL.\n"
	.string "¡A por ello!\p"
	.string "¡BLASCO ha recibido una POKé BALL!$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "BLASCO: ¡Hala!\n"
	.string "¡Gracias!$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}… ¿De verdad vendrías\n"
	.string "conmigo?$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "PAPÁ: ¿Qué, ha ido bien?$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "BLASCO: Sí, gracias.\n"
	.string "Aquí tienes tu POKéMON.\p"
	.string "{PLAYER}, gracias por acompañarme.\p"
	.string "Gracias a vosotros he podido atrapar\n"
	.string "a mi POKéMON.\p"
	.string "Te prometo que lo cuidaré\n"
	.string "muy bien.\p"
	.string "¡Oh! Mi madre me está esperando,\n"
	.string "¡tengo que irme!\p"
	.string "¡Adiós, {PLAYER}!$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "PAPÁ: Bueno…\p"
	.string "{PLAYER}, si quieres ser un ENTRENADOR\n"
	.string "fuerte, te doy un consejo.\p"
	.string "Ve a CIUDAD FÉRRICA, más allá\n"
	.string "de esta ciudad.\p"
	.string "Allí deberías desafiar a la\n"
	.string "LÍDER del GIMNASIO, PETRA.\p"
	.string "Después, ve a otros GIMNASIOS\n"
	.string "POKéMON y vence a sus LÍDERES.\p"
	.string "Consigue sus MEDALLAS,\n"
	.string "¿entendido?\p"
	.string "Yo también soy LÍDER de GIMNASIO.\n"
	.string "Algún día lucharemos, {PLAYER}.\p"
	.string "Pero solo cuando seas más\n"
	.string "fuerte.$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "PAPÁ: ¿Mm? ¿No vas al GIMNASIO\n"
	.string "POKéMON de CIUDAD FÉRRICA?\p"
	.string "No tiene gracia luchar contra un\n"
	.string "ENTRENADOR novato.\p"
	.string "{PLAYER}, quiero que me desafíes\n"
	.string "cuando seas mucho más fuerte.\p"
	.string "Lucharé contigo, {PLAYER}, cuando me\n"
	.string "enseñes cuatro MEDALLAS, ¿de acuerdo?$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "PAPÁ: Ya veo… Así que has vencido\n"
	.string "a la LÍDER de CIUDAD FÉRRICA.\p"
	.string "Pero hay muchos ENTRENADORES\n"
	.string "más fuertes que tú, {PLAYER}.\p"
	.string "Al otro lado del mar, en PUEBLO\n"
	.string "AZULIZA, está el LÍDER MARCIAL.\p"
	.string "Deberías ir a desafiarle.$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "PAPÁ: Mm… {PLAYER}, te has hecho\n"
	.string "más fuerte.\p"
	.string "Se nota por las MEDALLAS que\n"
	.string "has conseguido.$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "PAPÁ: Mm…\n"
	.string "Así que tienes cuatro MEDALLAS.\p"
	.string "Bien. Como te prometí, tendremos\n"
	.string "un combate POKéMON.\p"
	.string "{PLAYER}…\p"
	.string "Me hace muy feliz poder luchar\n"
	.string "de verdad contra ti.\p"
	.string "¡Pero un combate es un combate!\p"
	.string "Como LÍDER de GIMNASIO, haré todo\n"
	.string "lo que pueda para ganar.\p"
	.string "¡{PLAYER}, tú también tienes que\n"
	.string "darlo todo!$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "…\p"
	.string "No… No puede…\p"
	.string "No me lo puedo creer. {PLAYER}…\p"
	.string "¿He perdido contra {PLAYER}?\p"
	.string "¡Pero las reglas son las reglas!\n"
	.string "Toma, esto es tuyo.$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "¡{PLAYER} ha recibido la MEDALLA\n"
	.string "EQUILIBRIO de PAPÁ!$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "PAPÁ: Con esa MEDALLA sube la DEFENSA\n"
	.string "de todos tus POKéMON.\p"
	.string "Los POKéMON que sepan el movimiento\n"
	.string "de MO SURF podrán viajar por el agua.\p"
	.string "Este es mi regalo. {PLAYER}, seguro\n"
	.string "que sabes usarlo bien.$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "PAPÁ: La MT42 contiene IMAGEN.\p"
	.string "Duplica su potencia si el POKéMON\n"
	.string "está envenenado, paralizado\l"
	.string "o quemado.\p"
	.string "Puede convertir una mala situación\n"
	.string "en una ventaja.$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "PAPÁ: Como LÍDER de GIMNASIO, no sabes\n"
	.string "lo que me fastidia…\p"
	.string "Pero como padre, me pone contento\n"
	.string "y un poco triste a la vez. Qué raro…$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "¡Ah, estás aquí, {PLAYER}{KUN}!\p"
	.string "Ven conmigo, por favor.\n"
	.string "Quiero darte una cosa.$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "NORMAN, no te importa, ¿verdad?\p"
	.string "¿Me prestas a {PLAYER}{KUN}\n"
	.string "un par de minutos?$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "PAPÁ: {PLAYER}, deberías ir a ver\n"
	.string "a tu madre de vez en cuando.\p"
	.string "Yo me quedo aquí a entrenar\n"
	.string "el doble.\p"
	.string "¡Como ENTRENADOR, no puedo quedarme\n"
	.string "sin la revancha, {PLAYER}!$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "PAPÁ: {PLAYER}, ¿qué tal te va?\p"
	.string "El mundo de los POKéMON es profundo.\p"
	.string "De verdad creo que nunca se\n"
	.string "entrena lo suficiente.$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "¡Eh! ¿Qué tal, {PLAYER}, futura\n"
	.string "estrella de la LIGA?\p"
	.string "Las puertas de este GIMNASIO se abren\n"
	.string "al vencer a los ENTRENADORES.\p"
	.string "¡Ojo! Las puertas de esta sala ya\n"
	.string "están abiertas, ¡así que no me ataques!\p"
	.string "Los ENTRENADORES de este GIMNASIO\n"
	.string "usan todo tipo de objetos.\p"
	.string "La puerta de la izquierda lleva a\n"
	.string "la SALA VELOCIDAD.\p"
	.string "La de la derecha lleva a\n"
	.string "la SALA PRECISIÓN.\p"
	.string "El nombre de la sala está en la\n"
	.string "puerta, así que elige bien.\p"
	.string "Cuando elijas la puerta…\n"
	.string "¡Pues a por todas!$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "¡{PLAYER}! ¡Hala! ¡Has superado incluso\n"
	.string "a tu propio padre!\p"
	.string "¡Pero bueno!\n"
	.string "¡Qué giro tan impresionante!$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "Poder atacar antes que el\n"
	.string "rival…\p"
	.string "Solo con eso tengo una gran\n"
	.string "ventaja, ¿no crees?$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "¡Ha sido un combate magnífico!$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "Sigue a la siguiente sala, donde te\n"
	.string "espera un nuevo desafío.\p"
	.string "A la izquierda está la SALA CONFUSIÓN.\p"
	.string "La puerta de la derecha lleva a la\n"
	.string "SALA DEFENSA.$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "Ganes a quien ganes y pierdas con\n"
	.string "quien pierdas, nunca dejas de\l"
	.string "entrenarte a ti y a tus POKéMON.\p"
	.string "Para mí, eso es lo que significa\n"
	.string "ser LÍDER de GIMNASIO.$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "Esta es la SALA CONFUSIÓN.\p"
	.string "¡A ver lo unido que estás\n"
	.string "a tus POKéMON!$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "No he podido confundir a tu equipo…\n"
	.string "Estáis muy unidos.$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "La siguiente es la SALA FUERZA.\n"
	.string "¿Aguantarás la fuerza bruta?$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "Desde que venciste a nuestro LÍDER,\n"
	.string "el entrenamiento es mucho más duro.$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "Cuando crees que vas a ganar,\n"
	.string "tu rival recupera PS…\p"
	.string "¿Te imaginas lo horrible que\n"
	.string "debe de ser?\p"
	.string "¡Te voy a enseñar lo horrible\n"
	.string "que es!$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "No he recuperado bastantes PS…\n"
	.string "¡Qué ATAQUE!$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "Era de esperar de la familia de\n"
	.string "nuestro LÍDER.\p"
	.string "¡No, espera! La habilidad de un\n"
	.string "ENTRENADOR solo se gana con esfuerzo.\p"
	.string "He perdido porque no me he\n"
	.string "esforzado lo suficiente.\p"
	.string "¡Sigue! Ahora viene la SALA KO.$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "Seguiré entrenando en GIMNASIOS.\n"
	.string "Algún día seré LÍDER.$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "No me lo voy a tomar con calma por\n"
	.string "ser de la familia de nuestro LÍDER.\p"
	.string "¡Te enseñaré lo horrible que es\n"
	.string "para un POKéMON recibir un crítico!$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "Tu fuerza…\n"
	.string "Vas en serio.$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "Tu padre es fuerte de verdad.\n"
	.string "Es un ENTRENADOR que respeto.\p"
	.string "Y noto en ti el mismo brillo\n"
	.string "que en tu padre.\p"
	.string "¡Espero que tengas un combate\n"
	.string "increíble con él!$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "Desde que tu padre es el LÍDER,\n"
	.string "los ENTRENADORES de CIUDAD PETALIA\l"
	.string "se han hecho mucho más duros.$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "Jijiji…\n"
	.string "Esta es la SALA PRECISIÓN.\p"
	.string "Es muy fastidioso que todos los\n"
	.string "ataques acierten siempre.$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "Estabas un paso por encima…$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "Te esperan ENTRENADORES aún\n"
	.string "más fuertes.\p"
	.string "A la izquierda está la SALA DEFENSA\n"
	.string "y a la derecha la SALA RECUPERACIÓN.\p"
	.string "Se pondrá a prueba el ATAQUE de tus\n"
	.string "POKéMON en las dos.$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "¿Sabes qué buscamos los\n"
	.string "ENTRENADORES?\p"
	.string "Queremos ser almas gemelas de\n"
	.string "nuestros POKéMON.$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "Cuanta más DEFENSA, más temeraria\n"
	.string "puedo ser al atacar.$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "Nuestras defensas no bastaron…$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "Creo que me has dado una buena\n"
	.string "lección.\p"
	.string "¡Sigue! La puerta de la izquierda\n"
	.string "lleva a la SALA FUERZA.\p"
	.string "La de la derecha lleva a\n"
	.string "la SALA KO.\p"
	.string "En las dos hay ENTRENADORES que\n"
	.string "saben atacar muy bien.$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "¡Hola! ¿Has probado a usar SURF?$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "Nuestro LÍDER nos ha dicho que lo\n"
	.string "demos todo para vencerte.\p"
	.string "¡Aunque seas de la familia\n"
	.string "del LÍDER!$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "Pero… ¡Lo he dado todo!$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "Tu forma de usar a los POKéMON…\n"
	.string "Se parece a la de tu padre.\p"
	.string "¡Adelante! ¡El LÍDER del GIMNASIO,\n"
	.string "tu padre, te espera!$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "Claro, está bien hacer más\n"
	.string "fuertes a tus POKéMON.\p"
	.string "Pero ¿qué decide quién gana?\p"
	.string "Pues lo que sienten los\n"
	.string "ENTRENADORES por sus POKéMON.$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "Parece que esta puerta está\n"
	.string "cerrada ahora mismo…$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "El cartel dice “SALA VELOCIDAD”.\p"
	.string "¿Quieres entrar?$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "Parece que esta puerta está\n"
	.string "cerrada ahora mismo…$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "El cartel dice “SALA PRECISIÓN”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "El cartel dice “SALA CONFUSIÓN”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "El cartel dice “SALA DEFENSA”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "El cartel dice “SALA RECUPERACIÓN”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "El cartel dice “SALA FUERZA”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "El cartel dice “SALA KO”.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "“SALA DEL LÍDER DE GIMNASIO\p"
	.string "”¡Mira tú mismo qué POKéMON te\n"
	.string "esperan!”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_GymStatue:
	.string "GIMNASIO POKéMON DE PETALIA$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "GIMNASIO POKéMON DE PETALIA\p"
	.string "RECONOCIDOS POR NORMAN:\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "DAD: {PLAYER}…\n"
	.string "I had a feeling that you would come.\p"
	.string "I would never refuse to accept\n"
	.string "a challenge from you.\p"
	.string "You do understand, don't you?\p"
	.string "Inside a GYM, it doesn't matter that\n"
	.string "we are a parent and child.\p"
	.string "…No, because we are parent and child,\n"
	.string "we owe it to each other to do the best\l"
	.string "we can. Isn't that right, {PLAYER}?$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "Uh… Haha…\n"
	.string "Maybe that was going too hard…$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "DAD: {PLAYER}…\n"
	.string "What is your dream?\p"
	.string "My dream…\n"
	.string "Hahaha…\l"
	.string "It has already come true, actually.$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "DAD: {PLAYER}…\n"
	.string "I had a feeling that you would come.\p"
	.string "I would never refuse to accept\n"
	.string "a challenge from you.\p"
	.string "You do understand, don't you?\p"
	.string "Inside a GYM, it doesn't matter that\n"
	.string "we are a parent and child.\p"
	.string "Hm? Wait a second, {PLAYER}.\p"
	.string "Do you only have one POKéMON that is\n"
	.string "capable of battle?\p"
	.string "Sorry, but you'll have to come back\n"
	.string "with at least two POKéMON.$"

