	face_right
	step_end

MeteorFalls_1F_1R_EventScript_ProfCozmo::
	lock
	faceplayer
	goto_if_set FLAG_MET_PROF_COZMO, MeteorFalls_1F_1R_EventScript_MetCozmo
	setflag FLAG_MET_PROF_COZMO
	msgbox MeteorFalls_1F_1R_Text_MeetProfCozmo, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_EventScript_MetCozmo::
	msgbox MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_Text_WithThisMeteorite:
	.string "¡Jejeje!\p"
	.string "¡Con este METEORITO, eso del MONTE\n"
	.string "CENIZO…!$"

MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma:
	.string "¿Eh?\p"
	.string "No sé quién eres, pero si te metes\n"
	.string "en el camino del EQUIPO MAGMA,\l"
	.string "¡no esperes piedad!$"

MeteorFalls_1F_1R_Text_HoldItRightThereMagma:
	.string "¡Alto ahí, EQUIPO MAGMA!\p"
	.string "¡Os equivocáis si creéis que podéis\n"
	.string "hacer lo que queráis con el mundo!$"

MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua:
	.string "¡Jejeje!\n"
	.string "¡Hasta el EQUIPO AQUA se apunta!\p"
	.string "Pero es un rollo tener que\n"
	.string "encargarse de todos vosotros…\p"
	.string "Bah, ¡da igual!\p"
	.string "¡Ya tenemos el METEORITO, así que\n"
	.string "nos vamos al MONTE CENIZO!\p"
	.string "¡Jejeje! ¡Hasta luego, cabezas de\n"
	.string "chorlito del EQUIPO AQUA!$"

MeteorFalls_1F_1R_Text_ArchieSeenYouBefore:
	.string "AQUILES: ¿No te he visto antes?\n"
	.string "¿En el MUSEO de PORTUAL?\p"
	.string "Ah, así que te llamas {PLAYER}.\p"
	.string "En aquel momento pensé que eras\n"
	.string "uno de los secuaces del EQUIPO MAGMA.\p"
	.string "Hmpf…\n"
	.string "Qué criatura más rara.\p"
	.string "El EQUIPO MAGMA es un grupo de\n"
	.string "fanáticos muy peligroso.\p"
	.string "Lo destruyen todo con la excusa de\n"
	.string "expandir la tierra firme.\p"
	.string "¡Son los rivales de nosotros, el\n"
	.string "EQUIPO AQUA, que ama el mar!$"

MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma:
	.string "JEFE, deberíamos perseguir al\n"
	.string "EQUIPO MAGMA…$"

MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo:
	.string "AQUILES: ¡Sí, sí, debemos hacerlo!\n"
	.string "Hay que darse prisa.\p"
	.string "¡A saber qué hará el EQUIPO MAGMA\n"
	.string "en el MONTE CENIZO!$"

MeteorFalls_1F_1R_Text_ArchieFarewell:
	.string "AQUILES: {PLAYER}, tú también deberías\n"
	.string "vigilar al EQUIPO MAGMA.\p"
	.string "¡Adiós!$"

MeteorFalls_1F_1R_Text_MeetProfCozmo:
	.string "Yo… Soy COSMO…\n"
	.string "Soy PROFESOR…\p"
	.string "El EQUIPO MAGMA me pidió que les\n"
	.string "guiara a las CATARATAS METEORO…\p"
	.string "Pero me engañaron.\n"
	.string "Hasta me quitaron mi METEORITO…\p"
	.string "Y luego apareció otro grupo\n"
	.string "parecido, el EQUIPO AQUA.\p"
	.string "Después de eso…\n"
	.string "No entiendo nada.\p"
	.string "Pero ese EQUIPO MAGMA…\p"
	.string "¿Qué van a hacer con el METEORITO\n"
	.string "en el MONTE CENIZO?$"

MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney:
	.string "PROF. COSMO: Pero ese EQUIPO MAGMA…\p"
	.string "¿Qué van a hacer con el METEORITO\n"
	.string "en el MONTE CENIZO?$"
