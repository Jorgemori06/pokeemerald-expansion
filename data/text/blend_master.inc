BerryBlender_Text_BlendWithTheBlendMaster:
	.string "MAESTRO LICUADOR: ¡Así es!\n"
	.string "¡El MAESTRO LICUADOR soy yo!\p"
	.string "¡Licúa conmigo y verás la maestría\n"
	.string "que pongo al licuar!$"

BerryBlender_Text_SeeMyMasteryInAction:
	.string "MAESTRO LICUADOR: ¡Mmm! ¿Así que\n"
	.string "quieres ver mi maestría en acción?$"

BerryBlender_Text_TooBusyNowIsee:
	.string "¡Mmm!\p"
	.string "¡Así que ahora tienes prisa, ya veo!\p"
	.string "¡Pero no temas!\n"
	.string "¡Estaré aquí todo el día!\l"
	.string "¡Vuelve rápido de tu recado!$"

BerryBlender_Text_BlendMasterNoBerries:
	.string "¡Mmm!\p"
	.string "¡No tienes ni una BAYA!\p"
	.string "¡Estaré aquí todo el día!\n"
	.string "¡Vuelve rápido con BAYAS!$"

BerryBlender_Text_BlendMasterKnowHowToMakePokeblocks:
	.string "¡Por supuesto!\n"
	.string "¡Por supuesto!\p"
	.string "Por cierto…\n"
	.string "¿Sabes hacer {POKEBLOCK}S con\l"
	.string "BAYAS?$"

BerryBlender_Text_BlendMasterExplainBerryBlending:
	.string "¡Mmm!\p"
	.string "¡Ah, pero si es muy sencillo!\p"
	.string "Cuando la flecha de la LICUADORA\n"
	.string "llegue a tu marca, pulsa el Botón A.\p"
	.string "Eso es todo.\p"
	.string "Cuando veas con qué precisión pulso\n"
	.string "el Botón A, lo entenderás.$"

BerryBlender_Text_BlendMasterLetsBerryBlender:
	.string "¡Bien!\p"
	.string "¡Pues empecemos!\p"
	.string "¡Todos con el MAESTRO LICUADOR,\n"
	.string "a licuar BAYAS!$"

BerryBlender_Text_BlendMasterNoPokeblockCase:
	.string "¡Mmm!\p"
	.string "¡Parece que no tienes el\n"
	.string "TUBO {POKEBLOCK}!\p"
	.string "¡Estaré aquí todo el día!\n"
	.string "¡Consigue el TUBO {POKEBLOCK} y vuelve!$"

BerryBlender_Text_BlendMasterPokeblockCaseFull:
	.string "¡Mmm!\p"
	.string "¡Parece que tu TUBO {POKEBLOCK} está\n"
	.string "lleno!\p"
	.string "¡Estaré aquí todo el día!\n"
	.string "¡Usa algunos {POKEBLOCK}S y vuelve!$"

BerryBlender_Text_WhoaAwesome:
	.string "¡Hala!\n"
	.string "¡Increíble!$"

BerryBlender_Text_WickedlyFast:
	.string "¡Rapidísimo!$"

BerryBlender_Text_WhatAnExpert:
	.string "¡Qué experto!$"

BerryBlender_Text_MadeAmazingPokeblocksWithMaster:
	.string "¡Cuando licué con el MAESTRO,\n"
	.string "hicimos unos {POKEBLOCK}S increíbles!$"

BerryBlender_Text_QualitiesOfBlendMaster:
	.string "Unos ojos que siguen la flecha con\n"
	.string "precisión de máquina…\p"
	.string "Una mano que pulsa el Botón A\n"
	.string "con precisión de reloj…\p"
	.string "Esas cualidades hacen grande al\n"
	.string "MAESTRO LICUADOR.$"

BerryBlender_Text_MasterWorksOnSkillsInMountains:
	.string "Dicen que el MAESTRO LICUADOR entrena\n"
	.string "su técnica en lo más hondo del monte.\p"
	.string "A veces viene a CALAGUA a licuar\n"
	.string "BAYAS todo el día.$"
