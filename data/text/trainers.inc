	.string "frenos pueden hacerte mucho daño!\l"
	.string "¡Revisa bien tu BICI!$"

Route110_Text_AnthonyIntro:
	.string "¡Eh, tú!\n"
	.string "¿Puedes seguir mi ritmo?$"

