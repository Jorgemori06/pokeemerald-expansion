EventTicket_Text_OldSeaMapTooFar:
	.string "¿Qué pasa?\p"
	.string "¿Eres quien trae un mapa viejo\n"
	.string "y roto? A ver…\n"
	.string "… … … … … …\p"
	.string "¡Uf! Ese sitio queda muy lejos.\n"
	.string "No puedo llevarte, lo siento…$"

EventTicket_Text_BrineyHoldOnASecond:
	.string "SR. ARENQUE: ¡Un momento!\p"
	.string "¿Cómo vamos a decirle que no a\n"
	.string "alguien a quien le debo tanto?$"

EventTicket_Text_BrineyLetsSail:
	.string "{PLAYER}{KUN}, lo siento muchísimo.\p"
	.string "Has venido a pedirme ayuda y casi\n"
	.string "te mandamos a casa.\p"
	.string "Déjame que lo arregle.\p"
	.string "¡Zarpamos ahora mismo, claro!\p"
	.string "¡Vamos a buscar la isla de\n"
	.string "este MAPA VIEJO!$"

EventTicket_Text_OddTicketGetOnBoard:
	.string "¿Traes tú ese billete tan raro?\p"
	.string "Quieres ir a una isla que está\n"
	.string "muy, muy lejos.\p"
	.string "Nadie sabe qué hay allí…\p"
	.string "¡Solo de pensarlo me hierve la\n"
	.string "sangre de marinero!\p"
	.string "¡Sube a bordo!$"

